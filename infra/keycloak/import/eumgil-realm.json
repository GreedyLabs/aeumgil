{
  "realm": "eumgil",
  "displayName": "Eumgil Local SSO",
  "enabled": true,
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": true,
  "verifyEmail": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 28800,
  "ssoSessionMaxLifespan": 28800,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Default Eumgil user"
      },
      {
        "name": "admin",
        "description": "Eumgil administrator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "eumgil-web",
      "name": "Eumgil Web",
      "description": "Local Next.js OIDC client for Eumgil",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "eumgil-local-dev-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "http://localhost:3000/api/auth/callback/keycloak"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "profile",
        "roles",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "kakao",
      "displayName": "카카오",
      "providerId": "oidc",
      "enabled": true,
      "trustEmail": true,
      "config": {
        "clientId": "${SOCIAL_KAKAO_CLIENT_ID}",
        "clientSecret": "${SOCIAL_KAKAO_CLIENT_SECRET}",
        "authorizationUrl": "https://kauth.kakao.com/oauth/authorize",
        "tokenUrl": "https://kauth.kakao.com/oauth/token",
        "userInfoUrl": "https://kapi.kakao.com/v1/oidc/userinfo",
        "issuer": "https://kauth.kakao.com",
        "jwksUrl": "https://kauth.kakao.com/.well-known/jwks.json",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "clientAuthMethod": "client_secret_post",
        "defaultScope": "openid account_email profile_nickname profile_image",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "naver",
      "displayName": "네이버",
      "providerId": "naver",
      "enabled": true,
      "trustEmail": true,
      "config": {
        "clientId": "${SOCIAL_NAVER_CLIENT_ID}",
        "clientSecret": "${SOCIAL_NAVER_CLIENT_SECRET}",
        "syncMode": "IMPORT"
      }
    },
    {
      "alias": "google",
      "displayName": "Google",
      "providerId": "google",
      "enabled": true,
      "trustEmail": true,
      "config": {
        "clientId": "${SOCIAL_GOOGLE_CLIENT_ID}",
        "clientSecret": "${SOCIAL_GOOGLE_CLIENT_SECRET}",
        "defaultScope": "openid profile email",
        "syncMode": "IMPORT"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "kakao-nickname-to-firstname",
      "identityProviderAlias": "kakao",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "nickname",
        "user.attribute": "firstName",
        "syncMode": "INHERIT"
      }
    },
    {
      "name": "kakao-picture",
      "identityProviderAlias": "kakao",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "claim": "picture",
        "user.attribute": "picture",
        "syncMode": "INHERIT"
      }
    }
  ],
  "users": [
    {
      "username": "demo",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Eumgil",
      "lastName": "Demo",
      "email": "demo@example.com",
      "realmRoles": [
        "user"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "demo1234",
          "temporary": false
        }
      ]
    },
    {
      "username": "admin-user",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Eumgil",
      "lastName": "Admin",
      "email": "admin@example.com",
      "realmRoles": [
        "user",
        "admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "admin1234",
          "temporary": false
        }
      ]
    }
  ],
  "loginTheme": "eumgil",
  "internationalizationEnabled": true,
  "supportedLocales": [
    "ko",
    "en"
  ],
  "defaultLocale": "ko"
}
