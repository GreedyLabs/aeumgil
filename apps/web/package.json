{
  "name": "@eumgil/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "eval:real": "EUMGIL_EVAL_REAL=1 node --env-file=../../.env node_modules/vitest/vitest.mjs run src/server/agent/eval/real.eval.test.ts",
    "verify:api": "node scripts/verify-public-api.mjs",
    "find:content": "node --env-file=../../.env scripts/find-content-ids.mjs",
    "verify:enrichment": "node --env-file=../../.env scripts/verify-enrichment.mjs",
    "verify:db": "node --env-file=../../.env scripts/verify-db.mjs",
    "verify:keycloak": "node --env-file=../../.env scripts/verify-keycloak.mjs",
    "sync:spot-images": "node --env-file=../../.env scripts/sync-spot-images.mjs",
    "db:apply": "node --env-file=../../.env scripts/apply-app-schema.mjs",
    "db:seed:course": "node --env-file=../../.env scripts/seed-course-catalog.mjs",
    "db:collect:commerce": "node --env-file=../../.env scripts/collect-commerce.mjs",
    "db:apply:onboarding": "node --env-file=../../.env scripts/apply-onboarding-preference.mjs",
    "db:apply:profile": "node --env-file=../../.env scripts/apply-user-profile.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:collect:gangwon": "node --env-file=../../.env --experimental-strip-types scripts/collect-gangwon-catalog.mjs",
    "db:sync:accessibility": "node --env-file=../../.env scripts/sync-accessibility.mjs",
    "db:expand:curated": "node --env-file=../../.env --experimental-strip-types scripts/expand-curated-courses.mjs"
  },
  "dependencies": {
    "@eumgil/ui": "workspace:*",
    "drizzle-orm": "^0.36.4",
    "leaflet": "1.9.4",
    "next": "^15.1.6",
    "next-auth": "5.0.0-beta.25",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/leaflet": "1.9.21",
    "@types/node": "^22.10.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.28.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "^15.1.6",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
