# ─────────────────────────────────────────────
# 에움길 환경변수 템플릿
#
# 사용법:
#   1) 이 파일을 루트에 .env 로 복사:  cp .env.example .env
#   2) 아래 값을 실제 키로 채운다 (.env 는 .gitignore 로 커밋되지 않음)
#
# 로딩: apps/web/next.config.mjs 가 모노레포 루트의 .env / .env.local 을 읽는다.
#       (.env.local 이 있으면 .env 값을 덮어쓴다 → 개인 로컬 오버라이드용)
# 검증: 서버 시작 시 apps/web/src/lib/env.ts 에서 형식을 확인한다.
# ─────────────────────────────────────────────

# ── 앱 ──────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── 데이터베이스 ───────────────────────────
# 예: postgresql://USER:PASSWORD@HOST:5432/eumgil?schema=public
DATABASE_URL=""

# ── 공공데이터 OpenAPI 서비스키 ─────────────
# 공공데이터포털(data.go.kr) 발급 키는 보통 Encoding/Decoding 두 형태가 있다.
# 서버에서 직접 호출하므로 Decoding(원본) 키를 권장한다.

# 한국관광공사 국문 관광정보(TourAPI) — 관광지/행사/숙박/음식/이미지/위치기반
TOUR_API_SERVICE_KEY=""

# 한국관광공사 관광빅데이터(지역별 방문자 수) + 관광지 집중률 방문자 추이 예측
# (같은 계정 키로 묶이면 TOUR_API_SERVICE_KEY 와 동일 값을 넣어도 됨)
TOUR_BIGDATA_SERVICE_KEY=""

# 기상청 단기예보 + 생활기상지수(3.0)
KMA_SERVICE_KEY=""

# 한국환경공단 에어코리아 대기오염정보
AIRKOREA_SERVICE_KEY=""

# 한국도로공사 실시간 정체/소통 (data.ex.co.kr — 별도 발급 키일 수 있음)
EX_ROAD_SERVICE_KEY=""

# ── 인증 (Auth.js / NextAuth) ───────────────
# AUTH_SECRET 생성:  npx auth secret   (또는 openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# 카카오 로그인
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""

# 네이버 로그인
AUTH_NAVER_ID=""
AUTH_NAVER_SECRET=""

# Google 로그인
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Apple 로그인
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# ── 데이터 소스 토글 (개발용) ───────────────
# "mock" = 내장 mock 데이터 사용 / "live" = 실제 API·DB 사용 (Phase 2 이후)
DATA_SOURCE="mock"
