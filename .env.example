# ─────────────────────────────────────────────
# 에움길 환경변수 템플릿
#
# 사용법:
#   1) 이 파일을 루트에 .env 로 복사:  cp .env.example .env
#   2) 아래 값을 실제 키로 채운다 (.env 는 .gitignore 로 커밋되지 않음)
#
# 로딩: apps/web/next.config.mjs 가 모노레포 루트의 .env / .env.local 을 읽는다.
#       (.env.local 이 있으면 .env 값을 덮어쓴다 → 개인 로컬 오버라이드용)
# 검증: 서버 시작 시 apps/web/src/lib/env.ts 에서 형식을 확인한다.
# ─────────────────────────────────────────────

# ── 앱 ──────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── 데이터베이스 ───────────────────────────
# 예: postgresql://USER:PASSWORD@HOST:5432/eumgil?sslmode=require
DATABASE_URL=""
# 대상 스키마. 비우면 public. public 이 아닌 DB면 스키마명을 지정(예: eumgil).
DATABASE_SCHEMA=""

# ── 공공데이터 OpenAPI 서비스키 ─────────────
# 공공데이터포털(data.go.kr) 발급 키는 보통 Encoding/Decoding 두 형태가 있다.
# 서버에서 직접 호출하므로 Decoding(원본) 키를 권장한다.

# 한국관광공사 국문 관광정보(TourAPI) — 관광지/행사/숙박/음식/이미지/위치기반
TOUR_API_SERVICE_KEY=""

# 한국관광공사 관광빅데이터(지역별 방문자 수) + 관광지 집중률 방문자 추이 예측
# (같은 계정 키로 묶이면 TOUR_API_SERVICE_KEY 와 동일 값을 넣어도 됨)
TOUR_BIGDATA_SERVICE_KEY=""

# 기상청 단기예보 + 생활기상지수(3.0)
KMA_SERVICE_KEY=""

# 한국환경공단 에어코리아 대기오염정보
AIRKOREA_SERVICE_KEY=""

# 한국도로공사 실시간 정체/소통 (data.ex.co.kr — 별도 발급 키일 수 있음)
EX_ROAD_SERVICE_KEY=""

# ── 길찾기/이동시간 API (선택) ─────────────
# 기본 approx 는 외부 호출 없이 좌표 기반 근사 계산을 사용한다.
# kakao 로 설정하고 키를 넣으면 서버에서 관광지 좌표쌍 이동시간을 Kakao Mobility Directions 로 계산한다.
ROUTING_PROVIDER="approx"
KAKAO_MOBILITY_API_KEY=""

# ── 인증 (Auth.js + Keycloak OIDC) ─────────
# AUTH_SECRET 생성:  npx auth secret   (또는 openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Keycloak realm client (앱은 OIDC client, Keycloak 은 Identity Provider)
# 개발 기본값: issuer=http://localhost:8080/realms/eumgil, clientId=eumgil-web
AUTH_KEYCLOAK_ID="eumgil"
AUTH_KEYCLOAK_SECRET="eumgil-local-dev-secret"
AUTH_KEYCLOAK_ISSUER="http://localhost:8080/realms/eumgil"

# GreedyLabs 공용 Keycloak 을 쓸 때:
# AUTH_KEYCLOAK_ID="eumgil"
# AUTH_KEYCLOAK_SECRET="client-secret"
# AUTH_KEYCLOAK_ISSUER="https://auth.greedylabs.kr/realms/eumgil"

# 회원 탈퇴 시 Keycloak 계정 삭제용 service account 클라이언트 (선택, §7.2)
# realm 에 confidential client 생성 → Service Accounts 활성화 → realm-management
# 의 manage-users 역할 부여 후 주입. 미설정이면 탈퇴 시 앱 DB 만 삭제(계정은 수동 정리).
# KEYCLOAK_ADMIN_CLIENT_ID="eumgil-admin"
# KEYCLOAK_ADMIN_CLIENT_SECRET="service-account-secret"

# 로컬 Keycloak Docker Compose (선택)
KEYCLOAK_IMAGE="quay.io/keycloak/keycloak:latest"
KEYCLOAK_ADMIN="admin"
KEYCLOAK_ADMIN_PASSWORD="admin"

# ── 디버그 (개발용, 선택) ───────────────────
# 데이터 출처 추적 로그. "1"=전체 / "http,cache,repo" 처럼 네임스페이스 선택.
#   http  = 공공 API 실호출(✓/✗ + 소요 ms)
#   cache = 캐시 HIT/MISS/SET/FLUSH
#   repo  = DB 카탈로그·스팟 보강·코스 재정렬
EUMGIL_DEBUG=""
# 응답 캐시 파일 위치 (기본: OS 임시 디렉터리). 예: ./.cache
EUMGIL_CACHE_DIR=""
# "1"이면 dev 에서도 기동 시 실시간 캐시(wx:*/air:*) 워밍 실행. 운영 런타임은 항상 실행.
# dev 기본 꺼짐 — 재시작마다 공공 API 쿼터를 소모하지 않기 위함 (플랜 §2.3).
EUMGIL_WARMUP=""

# ── Agent LLM (선택) ───────────────────────
# 기본 heuristic 은 키 없이 동작한다. 실 LLM 검증 시에만 openai 로 전환.
EUMGIL_AGENT_LLM="heuristic"
# api.openai.com 사용 시 필수. 로컬 OpenAI-호환 서버(llama.cpp·vLLM 등)는 비워도 된다.
OPENAI_API_KEY=""
# 비우면 코드 기본값(gpt-4o-mini)을 사용. 모델명은 계정/시점에 맞게 명시 권장.
# 로컬 서버 예: "unsloth/Qwen3.5-4B-GGUF:Q4_K_M" (GET {BASE_URL}/models 로 확인)
OPENAI_MODEL=""
# OpenAI-compatible endpoint 를 쓸 때만 지정. 비우면 https://api.openai.com/v1
# 로컬 llama.cpp 예: "http://172.30.1.64:8080/v1"
OPENAI_BASE_URL=""
# LLM 호출 1회 타임아웃(ms). 비우면 30000. 초과 시 결정형 폴백.
OPENAI_TIMEOUT_MS=""
